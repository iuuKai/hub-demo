  "devDependencies": {
    "@types/express": "^5.0.6",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
