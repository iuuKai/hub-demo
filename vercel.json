{
	"version": 2,
	"buildCommand": "pnpm turbo run build",
	"outputDirectory": ".",
	"installCommand": "pnpm install --no-frozen-lockfile",
	"functions": {
		"api/agent-chat.ts": {
			"includeFiles": "packages/agent/**"
		}
	},
	"rewrites": [
		{
			"source": "/blog(/?)",
			"destination": "/apps/blog/.vitepress/dist/index.html"
		},
		{
			"source": "/blog/:path*",
			"destination": "/apps/blog/.vitepress/dist/:path*"
		},
		{
			"source": "/demo-exam-ai(/?)",
			"destination": "/apps/demo-exam-ai/dist/index.html"
		},
		{
			"source": "/demo-exam-ai/:path*.:ext",
			"destination": "/apps/demo-exam-ai/dist/:path*.:ext"
		},
		{
			"source": "/demo-exam-ai/:path*",
			"destination": "/apps/demo-exam-ai/dist/index.html"
		}
	]
}
