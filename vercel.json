{
	"version": 2,
	"buildCommand": "pnpm turbo run build",
	"outputDirectory": ".",
	"installCommand": "pnpm install --no-frozen-lockfile",
	"functions": {
		"api/[...path].ts": {
			"maxDuration": 10,
			"memory": 256
		},
		"api/agent‑chat.ts": {
			"maxDuration": 300,
			"memory": 512
		}
	},
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Permissions-Policy",
					"value": "fullscreen=(), geolocation=(), microphone=(), camera=()"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "/api/[...path]"
		},
		{
			"source": "/blog(/?)",
			"destination": "/apps/blog/.vitepress/dist/index.html"
		},
		{
			"source": "/blog/:path*",
			"destination": "/apps/blog/.vitepress/dist/:path*"
		}
	]
}
