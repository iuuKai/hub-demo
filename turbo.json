{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["SILICONFLOW_API_KEY", "SILICONFLOW_BASE_URL", "MODEL_NAME"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["**/dist/**"],
			"cache": true
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"lint": {
			"cache": true
		}
	}
}
